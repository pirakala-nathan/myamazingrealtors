# Copy to .env.local and fill in. Never commit real values.
# On Netlify, add the same variables under Site configuration → Environment variables.

# Public site URL (used for canonical URLs, sitemap and structured data)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Search engines: leave unset (blocked) on test sites. Set to true only on the live site at launch.
# ALLOW_INDEXING=true

# Firebase service account (Firebase console → Project settings → Service accounts →
# Generate new private key). Server-only: never prefix these with NEXT_PUBLIC_.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private key on one line with \n for line breaks, wrapped in double quotes.
FIREBASE_PRIVATE_KEY=

# Admin sign-in for PK (/admin). Pick a long password; the secret signs the session cookie.
# Generate a secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# PropTx (TRREB) listing data: token from https://syndication.ampre.ca/tokens (shown once).
# Without it, development uses a sample listing; production shows an error in the admin page.
PROPTX_TOKEN=

# Later milestones
# RESEND_API_KEY=            # emails each form submission to PK
# RESEND_FROM="My Amazing Realtors <forms@myamazingrealtors.com>"   # must be a domain verified in Resend
# NEWSLETTER_API_KEY=        # Mailchimp or Brevo, once chosen
# TURNSTILE_SECRET_KEY=      # spam protection on forms
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
